# ⚠️ 이 파일은 ★예시입니다. 실제 값을 절대 적지 마세요.
#    2026-08-07: 실제 자격증명이 들어가 있어 비웠습니다.
#    실제 값은 .env(gitignore) 또는 k8s Secret 으로만 둡니다.
APP_ENV=production
# 로컬 Vite 개발 서버가 연결할 FastAPI 주소
VITE_API_TARGET=http://127.0.0.1:18000
# 새 서버 SSH 접속 대상 및 개인키 경로 (개인키 파일은 직접 준비/지정)
CAPTCHA_SSH_HOST=
CAPTCHA_SSH_KEY=
APP_SECRET=
CAPTCHA_SITE_KEY=
CAPTCHA_SITE_SECRET=
CAPTCHA_ADMIN_KEY=
ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=false

DB_NAME=captcha_ms
DB_USER=catchap_dba
DB_PASSWORD=
DB_UNIX_SOCKET=/var/run/mysqld/mysqld.sock
DB_HOST=127.0.0.1
DB_PORT=3306

FINAL_DIR=data/final
LABELING_DIR=data/labeling
RUNTIME_DIR=data/runtime
STATIC_DIR=static/dist
CHALLENGE_TTL_SECONDS=180
VERIFICATION_TTL_SECONDS=300
MAX_ATTEMPTS=3
MAX_CHALLENGES_PER_MINUTE=30

# Internal behavior-AI service (sw deployment). The browser must never see
# this URL's private key. Keep policy in shadow until main-CAPTCHA metrics are
# calibrated with real user data.
BEHAVIOR_AI_URL=http://127.0.0.1:8010
BEHAVIOR_AI_BACKEND_KEY=
BEHAVIOR_AI_TIMEOUT_SECONDS=1.5
BEHAVIOR_POLICY_MODE=shadow
# off: 기존 CAPTCHA만 동작. shadow: 서버 배치 수집·AI 점수 기록만 수행.
# active: 수집 실패/무결성 실패도 step-up 처리. 정식 배포 후에만 활성화.
BEHAVIOR_EVENT_TRANSPORT=off
