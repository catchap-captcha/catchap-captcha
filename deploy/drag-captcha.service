[Unit]
Description=Drag CAPTCHA API
After=network.target mysql.service
Requires=mysql.service

[Service]
Type=simple
User=ms
Group=ms
WorkingDirectory=/srv/codex-workspaces/ms/drag-captcha
EnvironmentFile=/srv/codex-workspaces/ms/drag-captcha/.env
ExecStart=/srv/codex-workspaces/ms/drag-captcha/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=3
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

